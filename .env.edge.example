# Ubuntu 24.04 edge profile: 2 CPU cores, 2 GiB RAM, 16 GiB disk.
CLOUD_JWT_SECRET=replace-with-a-32-byte-or-longer-random-secret
CLOUD_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CLOUD_CORS_ORIGINS=https://control.example.com
CLOUD_SERVER_BIND_ADDRESS=
