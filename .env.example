# Copy to .env and replace every secret before deployment.
MYSQL_DATABASE=cloud_control
MYSQL_USER=cloud_control
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
CLOUD_JWT_SECRET=replace-with-a-32-byte-or-longer-random-secret
CLOUD_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CLOUD_CORS_ORIGINS=https://control.example.com
CLOUD_MODE=release
CLOUD_SERVER_BIND_ADDRESS=
CLOUD_MQTT_BIND_ADDRESS=
CLOUD_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# Keep bootstrap disabled until HTTPS/WSS is configured. Enable it briefly for
# first enrollment, then disable it again after every device has a token.
CLOUD_DEVICE_AUTH_REQUIRED=true
CLOUD_DEVICE_AUTO_REGISTER=false
CLOUD_AUTO_REGISTER_USER_ID=0
CLOUD_DEVICE_AUTO_REGISTER_RATE_LIMIT=10
CLOUD_DEVICE_AUTO_REGISTER_REQUIRE_TLS=true
CLOUD_DEVICE_WS_ATTEMPTS_PER_MINUTE=600
CLOUD_DEVICE_WS_MAX_CONNECTIONS_PER_IP=256

# Long-online clients implement cmd_id idempotency and application ACK, so the
# durable outbox is enabled by default.
CLOUD_RELIABLE_DELIVERY_ENABLED=true
CLOUD_RELIABLE_DELIVERY_RETRY_SECONDS=15
CLOUD_RELIABLE_DELIVERY_MAX_RETRY_SECONDS=300
CLOUD_RELIABLE_DELIVERY_MAX_ATTEMPTS=2048
CLOUD_RELIABLE_DELIVERY_RETRY_BATCH_SIZE=100
CLOUD_RELIABLE_DELIVERY_TTL_HOURS=168
CLOUD_CRON_CATCHUP_HOURS=24
CLOUD_ALERT_DELIVERY_AGE_MINUTES=10
CLOUD_ALERT_QUEUE_USAGE_PERCENT=70
CLOUD_ALERT_CRON_LAG_MINUTES=5
CLOUD_ALERT_RECONNECTS_PER_5_MIN=30
CLOUD_ALERT_COOLDOWN_MINUTES=15
CLOUD_NOTIFY_WEBHOOK_URL=
CLOUD_UPDATE_PUBLIC_KEY=

# Disk and database growth limits. The edge Compose file supplies smaller
# defaults suitable for a 2 GB RAM / 16 GB disk host.
CLOUD_DB_MAX_OPEN_CONNS=64
CLOUD_DB_MAX_IDLE_CONNS=32
CLOUD_SQLITE_CACHE_KB=32768
CLOUD_SQLITE_MMAP_BYTES=268435456
CLOUD_UPLOAD_MAX_SIZE=209715200
CLOUD_UPLOAD_MAX_TOTAL_BYTES=8589934592
CLOUD_DEVICE_LOG_RETENTION_DAYS=30
CLOUD_METRIC_RETENTION_DAYS=7
CLOUD_DELIVERY_RETENTION_DAYS=30
CLOUD_TASK_LOG_RETENTION_DAYS=30
CLOUD_SYSTEM_LOG_RETENTION_DAYS=30
CLOUD_SMS_RETENTION_DAYS=90
CLOUD_CLEANUP_BATCH_SIZE=1000
CLOUD_SCREENSHOT_RETENTION_HOURS=24
CLOUD_SCREENSHOT_MAX_BYTES=2147483648
CLOUD_TASK_MAX_DEVICES=2000
CLOUD_BACKUP_INTERVAL_HOURS=6
CLOUD_BACKUP_RETENTION_COUNT=14
CLOUD_DISK_WARN_PERCENT=80
CLOUD_DISK_STOP_WRITES_PERCENT=90

# Leave blank to keep the embedded broker. For the EMQX profile use
# tcp://emqx:1883 and a dedicated bridge account configured in EMQX.
CLOUD_MQTT_BROKER_URL=
CLOUD_MQTT_USERNAME=
CLOUD_MQTT_PASSWORD=
CLOUD_MQTT_CLIENT_ID=cloud-control-api-1

# Normal mode: embedded=1883 and external=1884. External cutover mode: set
# embedded=1885 and external=1883 so existing clients keep using port 1883.
EMBEDDED_MQTT_PORT=1883
EXTERNAL_MQTT_PORT=1884
MQTT_BIND_ADDRESS=0.0.0.0
SERVER_LOOPBACK_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# MySQL backup sidecar limits. Edge/SQLite mode does not use these values.
MYSQL_BACKUP_INTERVAL_SECONDS=21600
MYSQL_BACKUP_RETENTION_DAYS=14
MYSQL_BACKUP_KEEP_COUNT=14
